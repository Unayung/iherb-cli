    except (Auth, ApiError) as e:
        raise Auth(f"that session is not signed in to iHerb ({e})")
    try:
        li = cl.json("POST", CART + "/account/isloggedin", {"requestUrl": "/"}, session=True)
    except (ApiError, Net):
        li = {}
    return u, li


def _clipboard():
    for cmd in (["wl-paste", "-n"], ["pbpaste"], ["xclip", "-o", "-selection", "clipboard"]):
        try:
            r = subprocess.run(cmd, capture_output=True, text=True, timeout=5)
        except (FileNotFoundError, subprocess.TimeoutExpired):
            continue
        if r.returncode == 0 and r.stdout.strip():
            return r.stdout.strip()
    raise Auth("clipboard is empty or no clipboard tool (wl-paste / pbpaste / xclip)")


def _read_cookie_tty():
    """Raw tty read: the Linux line editor caps a line at 4095 bytes."""
    import termios
    fd = sys.stdin.fileno()
    old = termios.tcgetattr(fd)
    new = termios.tcgetattr(fd)
    new[3] &= ~(termios.ICANON | termios.ECHO)
    new[6][termios.VMIN], new[6][termios.VTIME] = 1, 0
    print("paste the Cookie header, then press Enter (input hidden):", file=sys.stderr)
    buf = bytearray()
    try:
        termios.tcsetattr(fd, termios.TCSANOW, new)
        while True:
            ch = os.read(fd, 65536)
            if not ch:
                break
            if b"\x03" in ch:
                raise KeyboardInterrupt
            buf += ch
            if b"\r" in ch or b"\n" in ch:
                break
    finally:
        termios.tcsetattr(fd, termios.TCSANOW, old)
        print(file=sys.stderr)
    return buf.decode("utf-8", "replace").splitlines()[0] if buf else ""


def _signed_in(cookies):
    return any(c["name"] == ".iHerbAuth.Cookies" for c in cookies)


def login_from_browser(args):
    _set_cdp(args.cdp)
    cookies, ua = edge_cookies()
    if _signed_in(cookies):
        try:
            return cookies, ua, _verify(cookies, ua, args.debug)
        except Auth:
            pass
    br = Browser(args.debug, LOGIN_URL, wait=False)
    try:
        print(f"Sign in to iHerb in the new background tab of the browser on {CDP} "
              f"(switch to it yourself). Waiting up to {args.wait}s...", file=sys.stderr)
        t0 = time.time()
        while time.time() - t0 < args.wait:
            time.sleep(4)
            cookies, ua = edge_cookies()
            if _signed_in(cookies):
                try:
                    return cookies, ua, _verify(cookies, ua, args.debug)
                except Auth:
                    pass
        raise Auth(f"not signed in after {args.wait}s; run `iherb login` again")
    finally:
        br.close()


def cmd_login(args):
    if args.from_clipboard or args.cookie_stdin:
        raw = _clipboard() if args.from_clipboard else \
            (_read_cookie_tty() if sys.stdin.isatty() else sys.stdin.read())
        cookies = header_to_cookies(clean_cookie(raw))
        ua = os.environ.get("IHERB_UA") or DEFAULT_UA
        u, li = _verify(cookies, ua, args.debug)
        src = "clipboard" if args.from_clipboard else "stdin"
    else:
        cookies, ua, (u, li) = login_from_browser(args)
        src = f"browser {CDP}"
    st = load_state()
    st.pop("source", None)
    exp = int(li["expirationMs"] / 1000) if li.get("expirationMs") else None
    st.update(cookies=cookies, ua=ua, cookie_in_keyring=bool(args.keyring),
              user={"id": u.get("id"), "email": u.get("email"), "name": u.get("welcomeName")},
              logged_in_at=int(time.time()), exp=exp, login_source=src)
    if st.get("keyring_parts"):
        keyring_clear(st["keyring_parts"])
    st.pop("keyring_parts", None)
    st.pop("keyring_error", None)
    if args.keyring:
        st["keyring_parts"] = keyring_save(cookies)
        if keyring_load(st["keyring_parts"]) != cookies:
            raise Auth("keyring did not return the session it was given; use the state file")
    save_state(st)
    out = {"user": st["user"], "stored": "keyring" if args.keyring else STATE_FILE,
           "expires": exp, "cookies": len(cookies)}
    return emit(ok(out), args.json, lambda: f"signed in as {u.get('welcomeName') or ''} <{u.get('email')}>; "
                f"session ({len(cookies)} cookies) saved to {out['stored']}"
                + (f", expires {time.strftime('%Y-%m-%d %H:%M', time.localtime(exp))}" if exp else ""))


