class Net(Exception):
    pass


class Blocked(Net):
    pass


class Auth(Exception):
    pass


class ApiError(Exception):
    def __init__(self, msg, detail=None):
        super().__init__(msg)
        self.detail = detail


class Usage(ApiError):
    pass


# ---------------------------------------------------------------- envelope
def ok(data):
    return {"ok": True, "data": data}


def err(msg, code=EX_ERR, **detail):
    return {"ok": False, "error": {"message": msg, "code": code, "detail": detail or None}}


def emit(payload, as_json, human=None):
    if as_json:
        print(json.dumps(payload, ensure_ascii=False, indent=2))
    elif payload.get("ok"):
        print(human() if callable(human) else
              (human if human is not None else
               json.dumps(payload["data"], ensure_ascii=False, indent=2)))
    else:
        print(payload["error"]["message"], file=sys.stderr)
    return EX_OK if payload.get("ok") else payload["error"]["code"]


def _w(text):
    return sum(2 if unicodedata.east_asian_width(c) in "WF" else 1 for c in str(text))


def table(rows, headers):
    if not rows:
        return "(no rows)"
    cols = list(zip(*([headers] + rows)))
    widths = [max(_w(c) for c in col) for col in cols]
    pad = lambda t, w: str(t) + " " * max(0, w - _w(t))  # noqa: E731
    out = ["  ".join(pad(h, w) for h, w in zip(headers, widths)).rstrip(),
           "  ".join("-" * w for w in widths)]
    for r in rows:
        out.append("  ".join(pad("" if c is None else c, w) for c, w in zip(r, widths)).rstrip())
    return "\n".join(out)


def clip(text, n):
    text = (text or "").replace("\n", " ").strip()
    if _w(text) <= n:
        return text
    out = ""
    for c in text:
        if _w(out + c) > n - 1:
            break
        out += c
    return out + "…"


def nt(v):
    return "" if v is None else f"NT${v:,.0f}"


def num(text):
    """'NT$1,313' -> 1313.0"""
    m = re.search(r"-?[\d,]+(?:\.\d+)?", text or "")
    return float(m.group(0).replace(",", "")) if m else None


# -------------------------------------------------------- CDP (stdlib ws)
class WS:
    def __init__(self, url, timeout=60):
        if not url.startswith("ws://"):
            raise Net(f"unsupported websocket url {url}")
        hostport, path = url[5:].split("/", 1)
        host, port = hostport.rsplit(":", 1)
        try:
            self.s = socket.create_connection((host, int(port)), timeout=timeout)
        except OSError as e:
            raise Net(f"cannot reach browser at {hostport}: {e}")
        key = base64.b64encode(os.urandom(16)).decode()
        self.s.sendall((f"GET /{path} HTTP/1.1\r\nHost: {hostport}\r\n"
                        "Upgrade: websocket\r\nConnection: Upgrade\r\n"
                        f"Sec-WebSocket-Key: {key}\r\n"
                        "Sec-WebSocket-Version: 13\r\n\r\n").encode())
        buf = b""
        while b"\r\n\r\n" not in buf:
            chunk = self.s.recv(4096)
            if not chunk:
                raise Net("websocket handshake closed")
            buf += chunk
        if b" 101 " not in buf.split(b"\r\n")[0]:
            raise Net("websocket handshake refused (start Edge with --remote-allow-origins='*')")
        self.rest = buf.split(b"\r\n\r\n", 1)[1]
        self.n = 0

    def _recv(self, n):
        while len(self.rest) < n:
            chunk = self.s.recv(65536)
            if not chunk:
                raise Net("browser closed the connection")
            self.rest += chunk
        out, self.rest = self.rest[:n], self.rest[n:]
        return out

    def _send(self, obj):
        data = json.dumps(obj).encode()
        hdr = bytearray([0x81])
        n = len(data)
        if n < 126:
            hdr.append(0x80 | n)
        elif n < 65536:
            hdr.append(0x80 | 126)
            hdr += struct.pack(">H", n)
        else:
            hdr.append(0x80 | 127)
            hdr += struct.pack(">Q", n)
        mask = os.urandom(4)
        hdr += mask
        self.s.sendall(bytes(hdr) + bytes(b ^ mask[i % 4] for i, b in enumerate(data)))

    def _recv_msg(self):
        msg = b""
        while True:
            b0, b1 = self._recv(2)
            n = b1 & 0x7F
            if n == 126:
                n = struct.unpack(">H", self._recv(2))[0]
            elif n == 127:
                n = struct.unpack(">Q", self._recv(8))[0]
            payload = self._recv(n)
            op = b0 & 0x0F
            if op == 8:
                raise Net("browser closed the websocket")
            if op in (9, 10):
                continue
            msg += payload
            if b0 & 0x80:
                return json.loads(msg)

    def call(self, method, **params):
        self.n += 1
        i = self.n
        self._send({"id": i, "method": method, "params": params})
        while True:
            m = self._recv_msg()
            if m.get("id") == i:
                if "error" in m:
                    raise Net(f"{method}: {m['error'].get('message')}")
                return m["result"]

    def close(self):
        try:
            self.s.close()
        except OSError:
            pass


def _http_json(path):
    try:
        with urllib.request.urlopen(CDP + path, timeout=5) as r:
            return json.loads(r.read())
    except OSError as e:
        raise Net(f"no browser on {CDP} ({e}). start Edge with --remote-debugging-port=9222")


def _set_cdp(cdp):
    global CDP
    if cdp:
        CDP = cdp


def edge_cookies():
    """All iHerb cookies of the CDP browser (browser-level, no tab needed)."""
    ver = _http_json("/json/version")
    b = WS(ver["webSocketDebuggerUrl"])
    try:
        cks = b.call("Storage.getCookies")["cookies"]
    finally:
        b.close()
    keep = [{"name": c["name"], "value": c["value"], "domain": c["domain"]}
            for c in cks if c["domain"].lstrip(".") == "iherb.com"
            or c["domain"].endswith(".iherb.com")]
    return keep, ver.get("User-Agent")


class Browser:
    """One background tab on tw.iherb.com, closed on exit. Never focused."""

    def __init__(self, debug=False, url=ORIGIN + "/", wait=True):
        self.debug = debug
        self.ver = _http_json("/json/version")
        self.b = WS(self.ver["webSocketDebuggerUrl"])
        self.tid = self.b.call("Target.createTarget", url=url, background=True)["targetId"]
        try:
            tgt = next(x for x in _http_json("/json/list") if x["id"] == self.tid)
            self.p = WS(tgt["webSocketDebuggerUrl"], timeout=90)
            if wait:
                self._wait_ready(urllib.parse.urlparse(url).netloc)
        except BaseException:
            self.close()
            raise

    def _wait_ready(self, host, limit=30):
        t0 = time.time()
        while time.time() - t0 < limit:
            r = self.eval("location.host + '|' + document.readyState + '|' + document.title")
            if r and r.startswith(host) and "|loading|" not in r and "Just a moment" not in r:
                return
            time.sleep(0.7)
        raise Net(f"{host} did not load in the background tab (Cloudflare check?)")

    def eval(self, expr):
        r = self.p.call("Runtime.evaluate", expression=expr, awaitPromise=True, returnByValue=True)
        if r.get("exceptionDetails"):
            raise ApiError("page script failed: " + str(
                r["exceptionDetails"].get("exception", {}).get("description")
                or r["exceptionDetails"].get("text")))
        return r.get("result", {}).get("value")

    def fetch(self, method, url, body=None, headers=None):
        opts = {"method": method, "credentials": "include", "headers": headers or {}}
        if body is not None:
            opts["body"] = body
        js = ("fetch(%s,%s).then(async r=>({http:r.status,text:await r.text()}))"
              % (json.dumps(url), json.dumps(opts)))
        r = self.eval(js)
        return r["http"], r["text"]

    def close(self):
        # Edge quits (clean exit) if the background tab we close is the
        # last "page" target left - guard: if ours is the only page, leave
        # it open (navigate to about:blank) instead of closing it.
        try:
            targets = self.b.call("Target.getTargets").get("targetInfos", [])
            pages = [t for t in targets if t.get("type") == "page"]
            only_page_left = len(pages) <= 1 and any(t.get("targetId") == self.tid for t in pages)
        except Exception:
            only_page_left = False
        try:
            if only_page_left:
                self.p.call("Page.navigate", url="about:blank")
            else:
                self.b.call("Target.closeTarget", targetId=self.tid)
        except Exception:
            pass
        for w in (getattr(self, "p", None), getattr(self, "b", None)):
            if w:
                w.close()


# ------------------------------------------------------------------ state
def _keyring(op, secret=None, acct="default"):
    try:
        if sys.platform == "darwin":
            cmd = {"set": ["security", "add-generic-password", "-U", "-a", acct,
                           "-s", KEYRING_SERVICE, "-w", secret],
                   "get": ["security", "find-generic-password", "-a", acct, "-s", KEYRING_SERVICE, "-w"],
                   "del": ["security", "delete-generic-password", "-a", acct, "-s", KEYRING_SERVICE]}[op]
            r = subprocess.run(cmd, capture_output=True, text=True)
        else:
            base = ["service", KEYRING_SERVICE, "account", acct]
            cmd = {"set": ["secret-tool", "store", "--label=iherb-cli"] + base,
                   "get": ["secret-tool", "lookup"] + base,
                   "del": ["secret-tool", "clear"] + base}[op]
            r = subprocess.run(cmd, input=secret if op == "set" else None,
                               capture_output=True, text=True)
    except FileNotFoundError:
        raise Auth("no keyring tool (macOS `security` / Linux `secret-tool`)")
    if op == "get":
        return r.stdout.strip() if r.returncode == 0 else None
    if op == "set" and r.returncode != 0:
        raise Auth("keyring write failed: " + r.stderr.strip())
    return True


# secret-tool lookup returns at most 8192 bytes (measured), iHerb cookies are ~10 KB
KR_CHUNK = 4000


def keyring_save(cookies):
    blob = json.dumps(cookies, separators=(",", ":"))
    parts = [blob[i:i + KR_CHUNK] for i in range(0, len(blob), KR_CHUNK)]
    for i, part in enumerate(parts):
        _keyring("set", part, f"default.{i}")
    return len(parts)


def keyring_load(n):
    parts = [_keyring("get", acct=f"default.{i}") for i in range(n or 0)]
    if not n or any(p is None for p in parts):
        raise Auth("saved keyring session is missing - run `iherb login --keyring`")
    try:
        return json.loads("".join(parts))
    except ValueError:
        raise Auth("saved keyring session is corrupt - run `iherb login --keyring`")


def keyring_clear(n):
    for i in range(max(n or 0, 1)):
        _keyring("del", acct=f"default.{i}")
    _keyring("del")  # pre-chunking single entry, if any


def header_to_cookies(header):
    return [{"name": p.split("=", 1)[0], "value": p.split("=", 1)[1], "domain": ".iherb.com"}
            for p in header.split("; ") if "=" in p]


def load_state():
    try:
        with open(STATE_FILE, encoding="utf-8") as f:
            st = json.load(f)
    except FileNotFoundError:
        st = {}
    except (OSError, ValueError) as e:
        raise ApiError(f"state file unreadable: {e}")
    if os.environ.get("IHERB_COOKIE"):
        st["cookies"], st["source"] = header_to_cookies(clean_cookie(os.environ["IHERB_COOKIE"])), "env"
    elif st.get("cookie_in_keyring"):
        try:
            st["cookies"] = keyring_load(st.get("keyring_parts"))
        except Auth as e:
            st["cookies"], st["keyring_error"] = [], str(e)
        st["source"] = "keyring"
    elif st.get("cookies"):
        st["source"] = "file"
    return st


def save_state(st):
    os.makedirs(STATE_DIR, mode=0o700, exist_ok=True)
    out = {k: v for k, v in st.items() if k not in ("source", "keyring_error")}
    if out.get("cookie_in_keyring"):
        out.pop("cookies", None)
    tmp = STATE_FILE + ".tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        json.dump(out, f, ensure_ascii=False, indent=2)
    os.chmod(tmp, 0o600)
    os.replace(tmp, STATE_FILE)


def cookie_for(cookies, url):
    host = urllib.parse.urlparse(url).hostname or ""
    seen, parts = set(), []
    for c in cookies or []:
        d = c.get("domain") or ".iherb.com"
        hit = host == d.lstrip(".") or (d.startswith(".") and host.endswith(d))
        if hit and c["name"] not in seen:
            seen.add(c["name"])
            parts.append(f"{c['name']}={c['value']}")
    return "; ".join(parts)


# -------------------------------------------------------------- transport
def is_challenge(code, text):
    head = (text or "")[:3000]
    return code in (403, 429, 503) and ("<" in head[:200] or not head) or "Just a moment" in head \
        or "challenge-platform" in head or "px-captcha" in head


class Http:
    """Direct HTTPS. Sends the saved session cookies for the target host."""

    def __init__(self, st, debug=False):
        self.st, self.debug = st, debug
        self.ua = os.environ.get("IHERB_UA") or st.get("ua") or DEFAULT_UA

    def fetch(self, method, url, body=None, headers=None):
        h = {"User-Agent": self.ua, "Accept-Language": "zh-TW,zh;q=0.9,en;q=0.8",
             "Origin": ORIGIN, "Referer": ORIGIN + "/"}
        h.update(headers or {})
        ck = cookie_for(self.st.get("cookies"), url)
        if ck:
            h["Cookie"] = ck
        data = body.encode() if isinstance(body, str) else body
        if self.debug:
            print(f"> {method} {url} {(body or '')[:300]}", file=sys.stderr)
        req = urllib.request.Request(url, data=data, headers=h, method=method)
        try:
            with urllib.request.urlopen(req, timeout=25) as r:
                code, text = r.status, r.read().decode("utf-8", "replace")
        except urllib.error.HTTPError as e:
            code, text = e.code, e.read().decode("utf-8", "replace")
        except OSError as e:
            raise Net(f"{urllib.parse.urlparse(url).netloc}: {e}")
        if self.debug:
            print(f"< {code} {text[:300]}", file=sys.stderr)
        return code, text


class Client:
    """HTTP first; anonymous reads fall back to a CDP background tab on a bot
    wall. Logged-in calls (account, cart) only ever use the saved session."""

    def __init__(self, args, st=None):
        self.args = args
        self.st = st if st is not None else load_state()
        self.http = Http(self.st, getattr(args, "debug", False))
        self.br = None

    def _browser(self):
        if not self.br:
            self.br = Browser(self.args.debug)
        return self.br

    def fetch(self, method, url, body=None, headers=None, session=False):
        via = getattr(self.args, "via", "auto")
        if session and not self.st.get("cookies"):
            raise Auth("not signed in - run `iherb login`")
        if via != "browser" or session:
            code, text = self.http.fetch(method, url, body, headers)
            if is_challenge(code, text):
                time.sleep(3)  # Cloudflare often lets the next calm request through
                code, text = self.http.fetch(method, url, body, headers)
            if not is_challenge(code, text):
                return code, text
            if via == "http" or session:
                raise Blocked(f"{urllib.parse.urlparse(url).netloc}: bot wall (HTTP {code}). "
                              + ("run `iherb login` again to refresh cf_clearance"
                                 if session else "retry later, or use --via browser"))
            print(f"note: HTTP blocked ({code}), retrying in a background Edge tab", file=sys.stderr)
        return self._browser().fetch(method, url, body, headers)

    def json(self, method, url, body=None, headers=None, session=False, what=None):
        h = {"Accept": "application/json", "Content-Type": "application/json"}
        h.update(headers or {})
        code, text = self.fetch(method, url, json.dumps(body) if body is not None else None, h, session)
        what = what or urllib.parse.urlparse(url).path
        if code == 401:
            raise Auth(f"{what}: not signed in (HTTP 401) - run `iherb login`")
        try:
            d = json.loads(text) if text.strip() else None
        except ValueError:
            raise ApiError(f"{what}: non-JSON reply (HTTP {code})", {"http": code})
        if code >= 400:
            raise ApiError(f"{what}: HTTP {code} {str(d)[:300]}", {"http": code, "reply": d})
        return d

    def gql(self, query, variables=None, name=None):
        d = self.json("POST", GQL, {"operationName": name, "query": query, "variables": variables or {}},
                      what="graphql " + (name or ""))
        if d.get("errors") and not d.get("data"):
            raise ApiError("graphql: " + "; ".join(e.get("message", "") for e in d["errors"])[:400])
        return d.get("data") or {}

    def cart_api(self, method, path, body=None):
        h = {"Pref": PREF}
        uid = (self.st.get("user") or {}).get("id")
        if uid:
            h["CustomerId"] = uid
        return self.json(method, CART + path, body, h, session=True, what=path)

    def __enter__(self):
        return self

    def __exit__(self, *a):
        if self.br:
            self.br.close()


# --------------------------------------------------------------- parsing
def product_id(ref):
    ref = str(ref).strip()
    if re.fullmatch(r"\d+", ref):
        return int(ref)
    m = re.search(r"/pr/(?:[^/?#]+/)?(\d+)", ref) or re.search(r"(?:pid_|/)(\d{2,})(?:[/?#]|$)", ref)
    if not m:
        raise Usage(f"not an iHerb product id or /pr/... URL: {ref!r}")
    return int(m.group(1))


def _attrs(tag):
    return {k: htmllib.unescape(v) for k, v in re.findall(r'([\w:-]+)="([^"]*)"', tag)}


def _strip(s):
    return htmllib.unescape(re.sub(r"\s+", " ", re.sub(r"<[^>]+>", " ", s or ""))).strip()


def parse_search(page):
    cells = [m.start() for m in re.finditer(r'<div\s+class="product-cell-container', page)]
    out = []
    for a, b in zip(cells, cells[1:] + [len(page)]):
        seg = page[a:b]
        link = re.search(r'<a [^>]*class="absolute-link product-link"[^>]*>', seg)
        if not link:
            continue
        at = _attrs(link.group(0))
        price = re.search(r'<span class="price[^"]*">\s*<bdi>([^<]+)</bdi>', seg)
        olp = re.search(r'<span class="price-olp">\s*<bdi>([^<]+)</bdi>', seg)
        off = re.search(r'<span class="percentage-off">\s*<bdi>([^<]+)</bdi>', seg)
        rt = re.search(r"title='([\d.]+)/5 - ([\d,]+)", seg)
        sold = re.search(r'class="recent-activity-message-wrapper">(.*?)</div>', seg, re.S)
        flags = [htmllib.unescape(f) for f in re.findall(
            r'class="product-flag [^"]*"[^>]*>(?:\s*<svg.*?</svg>)?\s*<bdi>([^<]+)</bdi>', seg, re.S)]
        oos = 'data-is-out-of-stock="true"' in seg
        discontinued = at.get("data-ga-is-discontinued") == "True"
        # "無法購買" (cannot purchase) block: iHerb shows this instead of a price for
        # listings that are blocked from purchase in this region/account - no <span
        # class="price"> is rendered at all, so price naturally parses as None. Caught
        # here too so callers don't have to infer it from a missing price.
        prohibited = 'class="prohibited-text' in seg
        p = num(price.group(1)) if price else None
        out.append({
            "id": int(at.get("data-product-id") or 0),
            "title": at.get("title"),
            "brand": at.get("data-ga-brand-name"),
            "part_number": at.get("data-part-number"),
            "price": p,
            "list_price": num(olp.group(1)) if olp else p,
            "discount": _strip(off.group(1)) if off else "",
            "rating": float(rt.group(1)) if rt else None,
            "reviews": int(rt.group(2).replace(",", "")) if rt else None,
            "in_stock": not oos and not discontinued and not prohibited
            and at.get("data-ga-is-out-of-stock") != "True",
            "purchasable": p is not None,
            "sold_30d": _strip(sold.group(1)) if sold else "",
            "flags": flags,
            "sponsored": at.get("data-sponsored") == "True",
            "url": at.get("href"),
        })
    total = re.search(r'id="product-count"[^>]*data-count="(\d+)"', page)
    return out, int(total.group(1)) if total else None


def parse_variants(page):
    groups = []
    rows = list(re.finditer(r'<div\s+class="product-grouping-row"\s+data-testid="product-grouping-row-([^"]+)"', page))
    for i, m in enumerate(rows):
        seg = page[m.start(): rows[i + 1].start() if i + 1 < len(rows) else m.start() + 60000]
        cur = re.search(r'data-current-item="([^"]*)"', seg)
        opts, seen = [], set()
        for t in re.finditer(r'<div\s+class="(?:attribute|thumbnail)-tile [^"]*"[^>]*>', seg):
            a = _attrs(t.group(0))
            if not a.get("data-pid") or a["data-pid"] in seen:
                continue
            seen.add(a["data-pid"])
            cls = a.get("class", "")
            opts.append({"value": a.get("data-val"), "id": int(a["data-pid"]),
                         "selected": "combo-selected" in cls or a.get("aria-selected") == "true",
                         "sold_out": a.get("data-is-out-of-stock") == "True",
                         "note": (a.get("aria-label") or "").replace(a.get("data-val") or "", "", 1).strip(),
                         "url": a.get("data-url")})
        groups.append({"name": htmllib.unescape(m.group(1)),
                       "current": htmllib.unescape(cur.group(1)) if cur else None, "options": opts})
    return groups


PRODUCT_Q = """query P($ids:[Int!]){products(input:{ids:$ids}){
 id label(withBrand:true) productName packageQuantity partNumber url
 brand{name} ugc{reviews{averageRating count}} hidePrice isAvailableToPurchase
 inventory{hasStock stock} specification{potency} productFlags{displayName}
 calculatedPrice(input:{}){price{discount{value formatted} list{value formatted}
   discountPercentage discountMessage appliedPromoCodeMessage}
   discounts{publicPCode{promoCode message discountPercentage} bogo{title}}}
 groupingAttributes{attributeValuePair(isDisabled:false){value{id label}}}
}}"""
SHIP_Q = """query S($id:Int!){freeShippingThreshold(input:{productId:$id}){amount{formatted value}}}"""


def parse_product(p):
    cp = p.get("calculatedPrice") or {}
    pr = cp.get("price") or {}
    disc = cp.get("discounts") or {}
    pc = disc.get("publicPCode") or {}
    inv = p.get("inventory") or {}
    rev = (p.get("ugc") or {}).get("reviews") or {}
    promos = [x for x in [pr.get("discountMessage"), pr.get("appliedPromoCodeMessage"),
                          pc.get("message"), (disc.get("bogo") or {}).get("title")] if x]
    return {
        "id": p.get("id"), "title": p.get("label"), "name": p.get("productName"),
        "brand": (p.get("brand") or {}).get("name"), "part_number": p.get("partNumber"),
        "package": p.get("packageQuantity"),
        "potency": (p.get("specification") or {}).get("potency"),
        "price": (pr.get("discount") or {}).get("value"),
        "list_price": (pr.get("list") or {}).get("value"),
        "discount_pct": pr.get("discountPercentage") or 0,
        "currency": "TWD",
        "promo_code": pc.get("promoCode"), "promo_pct": pc.get("discountPercentage"),
        "promos": promos,
        "in_stock": bool(inv.get("hasStock")), "stock": inv.get("stock"),
        "purchasable": p.get("isAvailableToPurchase"),
        "rating": rev.get("averageRating"), "reviews": rev.get("count"),
        "flags": [f.get("displayName") for f in p.get("productFlags") or []],
        "specs": [((x.get("value") or {}).get("label")) for x in
                  ((p.get("groupingAttributes") or {}).get("attributeValuePair") or [])],
        "seller": "iHerb",
        "url": p.get("url"),
    }


def get_products(cl, ids):
    d = cl.gql(PRODUCT_Q, {"ids": ids}, "P")
    got = {p["id"]: parse_product(p) for p in d.get("products") or [] if p}
    return got


def get_variants(cl, url):
    code, text = cl.fetch("GET", url, headers={"Accept": "text/html"})
    if code >= 400:
        raise ApiError(f"product page HTTP {code}")
    return parse_variants(text)


