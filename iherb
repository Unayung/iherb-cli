def cmd_search(args):
    if args.limit < 1 or args.page < 1:
        raise Usage("--limit and --page must be >= 1")
    q = {"kw": args.query}
    if args.sort:
        q["sr"] = SORTS[args.sort]
    if args.page > 1:
        q["p"] = args.page
    url = ORIGIN + "/search?" + urllib.parse.urlencode(q)
    with Client(args) as cl:
        code, text = cl.fetch("GET", url, headers={"Accept": "text/html"})
    if code >= 400:
        raise ApiError(f"search: HTTP {code}")
    rows, total = parse_search(text)
    n_before = len(rows)
    # Discontinued listings and ones iHerb marks "無法購買" (cannot purchase - blocked
    # from purchase in this region/account) render with no price at all, anywhere in
    # the result list regardless of --sort. They are not purchasable, so there is
    # nothing to show or sort by: drop them from every search result (measured live,
    # see parse_search()). This also means --sort price/price-desc can no longer
    # return a null price, and the remaining real prices are already in sorted order
    # within the page (iHerb's own sort is reliable once the priceless items are
    # removed - verified live, no client-side re-sort needed).
    rows = [r for r in rows if r["price"] is not None]
    n_dropped = n_before - len(rows)
    if args.min is not None:
        rows = [r for r in rows if r["price"] >= args.min]
    if args.max is not None:
        rows = [r for r in rows if r["price"] <= args.max]
    if args.in_stock:
        rows = [r for r in rows if r["in_stock"]]
    rows = rows[: args.limit]
    data = {"query": args.query, "page": args.page, "sort": args.sort or "featured",
            "total": total, "count": len(rows), "items": rows, "url": url,
            "dropped_no_price": n_dropped}
    return emit(ok(data), args.json, lambda: (f"{total} results, page {args.page}\n" if total else "") + table(
        [[r["id"], clip(r["title"], 46), nt(r["price"]),
          nt(r["list_price"]) if r["list_price"] != r["price"] else "", r["discount"],
          f"{r['rating']}/{r['reviews']:,}" if r["rating"] else "", "" if r["in_stock"] else "缺貨"]
         for r in rows], ["id", "title", "price", "orig", "off", "rating", "stock"]))


def _product_human(p):
    out = [p["title"] or "", p["url"] or "",
           f"id {p['id']}  part {p['part_number']}  brand {p['brand']}  seller {p['seller']}",
           f"price {nt(p['price'])}" + (f"  (list {nt(p['list_price'])}, -{p['discount_pct']}%)"
                                        if p["list_price"] and p["list_price"] != p["price"] else ""),
           f"stock {'in stock' if p['in_stock'] else 'OUT OF STOCK'}"
           + (f" ({p['stock']})" if p.get("stock") is not None else ""),
           f"rating {p['rating']} ({p['reviews']:,} reviews)" if p["rating"] else "rating -"]
    for x in p["promos"]:
        out.append(f"promo {x}")
    if p.get("shipping"):
        out.append(f"shipping {p['shipping']}")
    if p["flags"]:
        out.append("flags " + " / ".join(p["flags"]))
    if p.get("variants"):
        out.append("")
        for g in p["variants"]:
            out.append(f"[{g['name']}] current: {g['current']}")
            for o in g["options"]:
                out.append(f"  {'*' if o['selected'] else '-'} {o['value']}  id {o['id']}"
                           + ("  (sold out)" if o["sold_out"] else "")
                           + (f"  ({o['note']})" if o["note"] and not o["selected"] else ""))
    elif p.get("variants_note"):
        out.append("variants: " + p["variants_note"])
    return "\n".join(out)


