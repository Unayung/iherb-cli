COOKIE_PAIR = re.compile(r"^[!#$%&'*+.^_`|~0-9A-Za-z-]+=[\x21-\x7e]*$")


def clean_cookie(raw):
    raw = (raw or "").strip()
    if raw.lower().startswith("cookie:"):
        raw = raw.split(":", 1)[1].strip()
    pairs = [p.strip() for p in raw.replace("\n", ";").split(";")]
    good = [p for p in pairs if p and COOKIE_PAIR.match(p)]
    bad = [p for p in pairs if p and not COOKIE_PAIR.match(p)]
    if not any(p.startswith((".iHerbAuth.Cookies=", ".AuthServer.Cookies=")) for p in good):
        preview = raw[:40].encode("ascii", "replace").decode()
        raise Auth("that does not look like a signed-in iHerb Cookie header (no .iHerbAuth.Cookies; "
                   f"starts with {preview!r}). DevTools > Network > a catalog.app.iherb.com request > "
                   "Request Headers > copy the value of `Cookie`")
    if bad:
        print(f"note: dropped {len(bad)} malformed cookie part(s)", file=sys.stderr)
    return "; ".join(good)


def current_user(cl):
    d = cl.json("GET", CATALOG + "/catalog/currentUser", session=True, what="currentUser")
    if not d or not d.get("id"):
        raise Auth("currentUser returned no user - not signed in")
    return d


def _verify(cookies, ua, debug):
