def parse_cart(d):
    lines = []
    for n, x in enumerate(d.get("lineItems") or [], 1):
        pi = x.get("productInfo") or {}
        name = pi.get("displayName")
        lines.append({
            "line": n, "id": x.get("productId"),
            "title": f"{pi['brandName']}, {name}" if pi.get("brandName") and name else name,
            "part_number": pi.get("partNumber"),
            "spec": None,
            "quantity": x.get("quantity"),
            "unit_price": x.get("priceRawAmount"), "unit_price_text": x.get("price"),
            "list_price": x.get("listPriceRawAmount"),
            "subtotal": x.get("adjustedTotalRawAmount") or
            ((x.get("priceRawAmount") or 0) * (x.get("quantity") or 0)),
            "subtotal_text": x.get("adjustedTotal") or x.get("total"),
            "in_stock": not x.get("isOutOfStock"), "max_qty": x.get("maxAvailableQuantity"),
            "url": pi.get("productUrl") or (f"{ORIGIN}/pr/x/{x.get('productId')}" if x.get("productId") else None),
        })
    return {"count": d.get("cartQuantity"), "lines": lines,
            "subtotal": d.get("subTotal"), "discount": d.get("totalDiscount") or "",
            "shipping": d.get("shippingTotal"), "total": d.get("cartTotal"),
            "total_amount": d.get("orderTotalAmount"), "promo_code": d.get("promoCode"),
            "errors": d.get("cartErrors") or []}


SPEC_Q = ("query CartWeb_GetProductsGroupingAttributes($ids:[Int!]!){products(input:{ids:$ids}){id "
          "groupingAttributes{attributeValuePair(isDisabled:false){value{id label}}}}}")


def read_cart(cl):
    c = parse_cart(cl.cart_api("GET", "/api/Carts/v2"))
    ids = [x["id"] for x in c["lines"] if x["id"]]
    if ids:  # spec labels, the same query the cart page runs; cosmetic, so never fatal
        try:
            d = cl.gql(SPEC_Q, {"ids": ids}, "CartWeb_GetProductsGroupingAttributes")
            spec = {p["id"]: " / ".join((v.get("value") or {}).get("label") or "" for v in
                                        ((p.get("groupingAttributes") or {}).get("attributeValuePair") or []))
                    for p in d.get("products") or [] if p}
            for x in c["lines"]:
                x["spec"] = spec.get(x["id"]) or None
        except (ApiError, Net):
            pass
    return c


def _cart_human(c):
    t = table([[x["line"], x["id"], clip(x["title"], 44), x["spec"] or "", x["quantity"],
                x["unit_price_text"] or nt(x["unit_price"]), nt(x["subtotal"]),
                "" if x["in_stock"] else "缺貨"] for x in c["lines"]],
              ["#", "id", "item", "spec", "qty", "each", "subtotal", ""]) if c["lines"] else "(cart is empty)"
    return (t + f"\n\n{c['count']} item(s)  subtotal {c['subtotal']}"
            + (f"  discount {c['discount']}" if c["discount"] else "")
            + f"  shipping {c['shipping']}  total {c['total']}")


def find_line(c, ref):
    s = str(ref).strip()
    if re.fullmatch(r"\d+", s):
        n = int(s)
        hit = [x for x in c["lines"] if x["id"] == n]
        if hit:
            return hit[0]
        if 1 <= n <= len(c["lines"]):
            return c["lines"][n - 1]
    else:
        pid = product_id(s)
        hit = [x for x in c["lines"] if x["id"] == pid]
        if hit:
            return hit[0]
    raise ApiError(f"nothing in the cart matches {ref!r}",
                   {"cart": [f"#{x['line']} {x['id']} {x['title']}" for x in c["lines"]]})


def pick_spec(cl, pid, specs):
    """--spec TEXT -> the variant product id (iHerb variants are separate products)."""
    for want in specs:
        p = get_products(cl, [pid]).get(pid)
        groups = get_variants(cl, p["url"])
        if not groups:
            raise ApiError(f"product {pid} has no selectable specs (got --spec {want!r})")
        lw = want.lower().replace(" ", "")
        norm = lambda v: (v or "").lower().replace(" ", "")  # noqa: E731
        hits = [o for g in groups for o in g["options"] if norm(o["value"]) == lw] or \
            [o for g in groups for o in g["options"] if lw in norm(o["value"])]
        if len({o["id"] for o in hits}) > 1:
            raise ApiError(f"--spec {want!r} matches several: " +
                           ", ".join(f"{o['value']} ({o['id']})" for o in hits))
        if not hits:
            raise ApiError(f"no spec {want!r}; choices: " + "; ".join(
                f"[{g['name']}] " + " / ".join(o["value"] for o in g["options"]) for g in groups))
        if hits[0]["sold_out"]:
            raise ApiError(f"spec {hits[0]['value']} (id {hits[0]['id']}) is sold out")
        pid = hits[0]["id"]
    return pid


def cmd_cart(args):
    with Client(args) as cl:
        if not cl.st.get("cookies"):
            raise Auth("not signed in - run `iherb login`")
        if args.action == "list":
            c = read_cart(cl)
            return emit(ok(c), args.json, lambda: _cart_human(c))

        if args.action == "add":
            if not args.ref:
                raise Usage("cart add needs a product id or URL")
            if args.qty < 1:
                raise Usage("--qty must be >= 1")
            pid = product_id(args.ref)
            if args.spec:
                pid = pick_spec(cl, pid, args.spec)
            p = get_products(cl, [pid]).get(pid)
            if not p:
                raise ApiError(f"no iHerb product {pid}")
            if not p["in_stock"] or p["purchasable"] is False:
                raise ApiError(f"{p['title']} ({pid}) is out of stock / not purchasable")
            plan = {"id": pid, "title": p["title"], "quantity": args.qty, "price": p["price"],
                    "estimate": (p["price"] or 0) * args.qty, "url": p["url"]}
            desc = f"{args.qty}x {p['title']} ({pid}) {nt(p['price'])} each"
            if not args.yes:
                return emit(ok(dict(plan, dry_run=True)), args.json,
                            f"would add to cart: {desc}. re-run with --yes")
            before = {x["id"]: x["quantity"] for x in read_cart(cl)["lines"]}
            cl.cart_api("POST", "/api/Carts/v3/catalog/lineItems", {
                "lineItems": [{"productId": pid, "quantity": args.qty, "frequencyId": None}],
                "sourceModule": "ProductDetailsPage", "referralCode": "", "promoCode": ""})
            c = read_cart(cl)
            line = next((x for x in c["lines"] if x["id"] == pid), None)
            if not line or line["quantity"] <= before.get(pid, 0):
                raise ApiError("iHerb accepted the add but the cart does not show it",
                               {"cart": c["lines"]})
            return emit(ok({"added": plan, "verified_line": line, "cart_count": c["count"],
                            "cart_total": c["total"]}), args.json,
                        f"added; cart now has #{line['line']} {line['quantity']}x {line['title']} "
                        f"({line['unit_price_text']} each) - {c['count']} item(s), total {c['total']}")

        c = read_cart(cl)
        if not args.ref:
            raise Usage(f"cart {args.action} needs a line number, product id or URL")
        line = find_line(c, args.ref)
        if args.action == "qty":
            if args.n is None or args.n < 0:
                raise Usage("cart qty <line> N  (N >= 1; use `cart rm` to delete)")
            if args.n == 0:
                raise Usage("use `cart rm` to delete a line")
            if line["max_qty"] and args.n > line["max_qty"]:
                raise ApiError(f"max quantity for this item is {line['max_qty']}")
            if not args.yes:
                return emit(ok({"dry_run": True, "line": line, "new_quantity": args.n}), args.json,
                            f"would set #{line['line']} {line['title']} qty {line['quantity']} -> {args.n}. "
                            "re-run with --yes")
            cl.cart_api("PUT", "/api/Carts/v2/lineitem", {"productId": line["id"], "quantity": args.n})
            c2 = read_cart(cl)
            nl = next((x for x in c2["lines"] if x["id"] == line["id"]), None)
            if not nl or nl["quantity"] != args.n:
                raise ApiError("iHerb accepted the change but the cart shows "
                               f"{nl['quantity'] if nl else 'no line'}", {"cart": c2["lines"]})
            return emit(ok({"verified_line": nl, "cart_count": c2["count"], "cart_total": c2["total"]}),
                        args.json, f"#{nl['line']} {nl['title']} now qty {nl['quantity']} "
                                   f"({nl['subtotal_text'] or nt(nl['subtotal'])}); total {c2['total']}")
        # rm
        if not args.yes:
            return emit(ok({"dry_run": True, "remove": line}), args.json,
                        f"would remove #{line['line']} {line['quantity']}x {line['title']} ({line['id']}). "
                        "re-run with --yes")
        cl.cart_api("DELETE", "/api/Carts/v2/lineitems/products",
                    {"lineItems": [line["id"]], "sourceModule": "CartLists"})
        c2 = read_cart(cl)
        if any(x["id"] == line["id"] for x in c2["lines"]):
            raise ApiError("iHerb accepted the remove but the item is still in the cart")
        return emit(ok({"removed": line, "cart_count": c2["count"], "cart_total": c2["total"]}),
                    args.json, f"removed {line['title']} ({line['id']}); cart now "
                               f"{c2['count']} item(s), total {c2['total']}")


# ------------------------------------------------------------------ parser
class Parser(argparse.ArgumentParser):
    def error(self, message):
        as_json = "--json" in sys.argv
        emit(err(f"{self.prog}: {message}", EX_USAGE), as_json)
        if not as_json:
            self.print_usage(sys.stderr)
        sys.exit(EX_USAGE)


def build_parser():
    p = Parser(prog="iherb", description="iHerb Taiwan (tw.iherb.com) from the shell (no checkout).")
    p.add_argument("--version", action="version", version=VERSION)
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--json", action="store_true", help="stable {ok, data|error} envelope")
    common.add_argument("--debug", action="store_true", help="dump requests to stderr")
    common.add_argument("--via", choices=["auto", "http", "browser"], default="auto",
                        help="transport for anonymous reads: HTTP, CDP background tab, or "
                             "HTTP with browser fallback (default)")
    sub = p.add_subparsers(dest="cmd", required=True, parser_class=Parser)

    sub.add_parser("doctor", parents=[common], help="transport, API reachability, login state"
                   ).set_defaults(fn=cmd_doctor)

    s = sub.add_parser("search", parents=[common], help="search products")
    s.add_argument("query")
    s.add_argument("--limit", type=int, default=20)
    s.add_argument("--page", type=int, default=1)
    s.add_argument("--sort", choices=list(SORTS))
    s.add_argument("--min", type=float, help="min price TWD (filters this page)")
    s.add_argument("--max", type=float, help="max price TWD (filters this page)")
    s.add_argument("--in-stock", action="store_true")
    s.set_defaults(fn=cmd_search)

    pr = sub.add_parser("product", aliases=["item"], parents=[common],
                        help="one product: price, promo, stock, rating, specs/variants")
    pr.add_argument("product", help="product id or tw.iherb.com/pr/... URL")
    pr.add_argument("--no-variants", action="store_true", help="skip the product page (variants)")
    pr.set_defaults(fn=cmd_product)

    pc = sub.add_parser("price", parents=[common], help="quick price check for many products")
    pc.add_argument("products", nargs="+", help="ids or URLs")
    pc.set_defaults(fn=cmd_price)

    lg = sub.add_parser("login", parents=[common], help="save a signed-in iHerb session")
    g = lg.add_mutually_exclusive_group()
    g.add_argument("--from-browser", action="store_true",
                   help="(default) copy the session from Edge on CDP; opens the sign-in page if needed")
    g.add_argument("--from-clipboard", action="store_true", help="Cookie header from the clipboard")
    g.add_argument("--cookie-stdin", action="store_true", help="paste/pipe a Cookie header")
    lg.add_argument("--cdp", help=f"CDP endpoint (default {CDP})")
    lg.add_argument("--wait", type=int, default=300, help="seconds to wait for you to sign in")
    lg.add_argument("--keyring", action="store_true", help="store cookies in the OS keyring")
    lg.set_defaults(fn=cmd_login)
    sub.add_parser("logout", parents=[common], help="delete the saved session").set_defaults(fn=cmd_logout)
    sub.add_parser("whoami", parents=[common], help="verify the saved session over HTTP"
                   ).set_defaults(fn=cmd_whoami)

    c = sub.add_parser("cart", parents=[common], help="cart list/add/rm/qty (needs login; no checkout)")
    c.add_argument("action", choices=["list", "add", "rm", "qty"])
    c.add_argument("ref", nargs="?", help="add: id/URL; rm/qty: line #, id or URL")
    c.add_argument("n", nargs="?", type=int, help="qty: new quantity")
    c.add_argument("--qty", type=int, default=1, help="add: quantity")
    c.add_argument("--spec", "--opt", action="append", help="add: variant text, e.g. '240 入' (repeatable)")
    c.add_argument("--yes", action="store_true", help="really write; without it only preview")
    c.set_defaults(fn=cmd_cart)

    r = sub.add_parser("raw", parents=[common], help="GET passthrough for debugging (JSON out)")
    r.add_argument("path", help="tw.iherb.com path or full iHerb API URL")
    r.set_defaults(fn=cmd_raw)
    return p


def main(argv=None):
    args = build_parser().parse_args(argv)
    try:
        return args.fn(args)
    except Auth as e:
        return emit(err(str(e), EX_AUTH), args.json)
    except Net as e:
        return emit(err(str(e), EX_NET), args.json)
    except Usage as e:
        return emit(err(str(e), EX_USAGE), args.json)
    except ApiError as e:
        return emit(err(str(e), EX_ERR, **(e.detail or {})), args.json)
    except BrokenPipeError:
        return EX_OK
    except KeyboardInterrupt:
        return EX_ERR


if __name__ == "__main__":
    sys.exit(main())
